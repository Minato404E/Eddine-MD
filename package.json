{
  "name": "eddine-md",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Salah Eddine's multi-account WhatsApp bot for Node.js hosts and Windows",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
