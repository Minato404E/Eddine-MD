    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "update:media": "node scripts/update-media.js",
    "setup": "node scripts/setup.js",
    "package:public": "node scripts/package-public.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "image-size": "2.0.2",
    "jsqr": "1.4.0",
    "jszip": "3.10.1",
    "mathjs": "^15.0.0",
    "node-webpmux": "3.2.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "pino": "^9.9.0",
    "qrcode": "1.5.4",
    "tesseract.js": "6.0.1"
  },
  "main": "index.js",
  "allowScripts": {
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "ffmpeg-static@5.3.0": true,
    "protobufjs@7.6.6": true
